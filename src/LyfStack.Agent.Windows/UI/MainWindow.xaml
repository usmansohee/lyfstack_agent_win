<Window x:Class="LyfStack.Agent.Windows.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LyfStack Agent"
        Height="760"
        Width="980"
        MinHeight="700"
        MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F7"
        FontFamily="Segoe UI">
  <Window.Resources>
    <Style x:Key="StatLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#64748B"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="StatValue" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#0F172A"/>
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="#0F766E"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="18,10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#0D9488"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.55"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="GhostButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#334155"/>
      <Setter Property="BorderBrush" Value="#CBD5E1"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SettingsLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#64748B"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="SettingsValue" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#0F172A"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="InfoKey" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#94A3B8"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="InfoVal" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#F8FAFC"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,14"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Padding="28,22,28,18">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#0F172A" Offset="0"/>
          <GradientStop Color="#134E4A" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="LyfStack" FontSize="28" FontWeight="Bold" Foreground="White"/>
          <TextBlock Text="LyfStack.Agent.Windows" Margin="0,4,0,0" FontSize="13" Foreground="#99F6E4"/>
        </StackPanel>
        <Border Grid.Column="1" VerticalAlignment="Center" Background="#1AFFFFFF" CornerRadius="20" Padding="12,8">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#22C55E" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Text="Tracking active" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <TabControl Grid.Row="1" Margin="18,14,18,18" Background="Transparent" BorderThickness="0">
      <TabControl.Resources>
        <Style TargetType="TabItem">
          <Setter Property="Padding" Value="16,8"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
          <Setter Property="Foreground" Value="#64748B"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="TabItem">
                <Border x:Name="tabBd" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}" Margin="0,0,8,8">
                  <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="tabBd" Property="Background" Value="White"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </TabControl.Resources>

      <!-- Activity -->
      <TabItem Header="Activity">
        <Grid Margin="0,4,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Border Background="White" CornerRadius="14" Padding="14,12">
            <Border.Effect>
              <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.08"/>
            </Border.Effect>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource StatLabel}" Text="NOW"/>
                <TextBlock x:Name="NowAppText" Style="{StaticResource StatValue}" Text="—" FontSize="16" Margin="0,2,0,0"/>
                <TextBlock x:Name="NowStateText" Foreground="#0D9488" FontSize="11" Margin="0,2,0,0" Text="Waiting"/>
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Style="{StaticResource StatLabel}" Text="TODAY ACTIVE"/>
                <TextBlock x:Name="TodayActiveText" Style="{StaticResource StatValue}" Text="00:00" FontSize="20" Margin="0,2,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource StatLabel}" Text="SESSIONS"/>
                <TextBlock x:Name="SessionCountText" Style="{StaticResource StatValue}" Text="0" FontSize="20" Margin="0,2,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="3">
                <TextBlock Style="{StaticResource StatLabel}" Text="SYNC"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                  <Ellipse x:Name="SyncDot" Width="10" Height="10" Fill="#94A3B8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                  <TextBlock x:Name="SyncStatusText" Text="Not synced yet" Foreground="#334155" VerticalAlignment="Center" FontSize="13"/>
                </StackPanel>
                <TextBlock x:Name="LastSyncText" Foreground="#94A3B8" FontSize="11" Margin="18,2,0,0" Text=""/>
              </StackPanel>
            </Grid>
          </Border>

          <Border Grid.Row="1" Margin="0,10,0,0" Background="White" CornerRadius="14" Padding="16,12">
            <Border.Effect>
              <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.08"/>
            </Border.Effect>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <DockPanel Margin="0,0,0,10">
                <TextBlock x:Name="SummaryTitleText" Text="Summary · Today" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                <ComboBox x:Name="HistoryRangeCombo" DockPanel.Dock="Right" Width="140" HorizontalAlignment="Right"
                          SelectionChanged="HistoryRangeCombo_OnSelectionChanged">
                  <ComboBoxItem Tag="Today" Content="Today" IsSelected="True"/>
                  <ComboBoxItem Tag="Week" Content="This week"/>
                  <ComboBoxItem Tag="Month" Content="This month"/>
                  <ComboBoxItem Tag="Year" Content="This year"/>
                  <ComboBoxItem Tag="All" Content="All time"/>
                </ComboBox>
              </DockPanel>

              <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,10">
                <Border Background="#F0FDFA" CornerRadius="10" Padding="10,8" Margin="0,0,6,0">
                  <StackPanel>
                    <TextBlock Text="ACTIVE" Foreground="#0F766E" FontSize="10" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SummaryActiveText" Text="00:00" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,4,0,0"/>
                  </StackPanel>
                </Border>
                <Border Background="#FFF7ED" CornerRadius="10" Padding="10,8" Margin="0,0,6,0">
                  <StackPanel>
                    <TextBlock Text="IDLE" Foreground="#C2410C" FontSize="10" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SummaryIdleText" Text="00:00" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,4,0,0"/>
                  </StackPanel>
                </Border>
                <Border Background="#EFF6FF" CornerRadius="10" Padding="10,8" Margin="0,0,6,0">
                  <StackPanel>
                    <TextBlock Text="TRACKED" Foreground="#1D4ED8" FontSize="10" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SummaryTrackedText" Text="00:00" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,4,0,0"/>
                  </StackPanel>
                </Border>
                <Border Background="#F8FAFC" CornerRadius="10" Padding="10,8">
                  <StackPanel>
                    <TextBlock Text="FOCUS" Foreground="#475569" FontSize="10" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SummaryFocusText" Text="0%" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,4,0,0"/>
                  </StackPanel>
                </Border>
              </UniformGrid>

              <TextBlock Grid.Row="2" x:Name="SummaryMetaText" Foreground="#64748B" FontSize="12" Margin="0,0,0,8"
                         Text="0 sessions · 0 apps · Pending sync: 0"/>

              <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.2*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Text="Top apps" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,6"/>
                  <ItemsControl x:Name="TopAppsList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <DockPanel Margin="0,0,0,6">
                          <TextBlock DockPanel.Dock="Right" Text="{Binding ActiveText}" FontWeight="SemiBold" Foreground="#0F172A"/>
                          <TextBlock>
                            <Run Text="{Binding Name}" Foreground="#0F172A"/>
                            <Run Text=" · " Foreground="#CBD5E1"/>
                            <Run Text="{Binding Category}" Foreground="#0D9488"/>
                          </TextBlock>
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="By category" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,6"/>
                  <ItemsControl x:Name="CategoryStatsList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <DockPanel Margin="0,0,0,6">
                          <TextBlock DockPanel.Dock="Right" Text="{Binding ActiveText}" FontWeight="SemiBold" Foreground="#0F172A"/>
                          <TextBlock>
                            <Run Text="{Binding Category}" Foreground="#0F172A"/>
                            <Run Text=" · " Foreground="#CBD5E1"/>
                            <Run Text="{Binding SessionsText}" Foreground="#94A3B8"/>
                          </TextBlock>
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Grid>
            </Grid>
          </Border>

          <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
              <Button x:Name="PauseButton" Content="Pause tracking" Style="{StaticResource GhostButton}" Margin="0,0,10,0" Click="PauseButton_OnClick"/>
              <Button x:Name="SyncButton" Content="Sync now" Style="{StaticResource PrimaryButton}" Click="SyncButton_OnClick"/>
            </StackPanel>
            <TextBlock x:Name="FooterHint" VerticalAlignment="Center" Foreground="#64748B" FontSize="12"
                       Text="History lives in its own tab. Sync uploads only new/changed sessions."/>
          </DockPanel>
        </Grid>
      </TabItem>

      <!-- History -->
      <TabItem Header="History">
        <Grid Margin="0,4,0,0">
          <Border Background="White" CornerRadius="16" Padding="8">
            <Border.Effect>
              <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.08"/>
            </Border.Effect>
            <DockPanel>
              <DockPanel DockPanel.Dock="Top" Margin="12,10,12,8">
                <TextBlock Text="Activity history" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                  <ComboBox x:Name="HistoryRangeCombo2" Width="140" Margin="0,0,10,0" VerticalAlignment="Center"
                            SelectionChanged="HistoryRangeCombo2_OnSelectionChanged">
                    <ComboBoxItem Tag="Today" Content="Today" IsSelected="True"/>
                    <ComboBoxItem Tag="Week" Content="This week"/>
                    <ComboBoxItem Tag="Month" Content="This month"/>
                    <ComboBoxItem Tag="Year" Content="This year"/>
                    <ComboBoxItem Tag="All" Content="All time"/>
                  </ComboBox>
                  <Button Content="CSV" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="ExportCsv_OnClick"/>
                  <Button Content="JSON" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="ExportJson_OnClick"/>
                  <Button Content="Refresh" Style="{StaticResource GhostButton}" Click="RefreshButton_OnClick"/>
                </StackPanel>
              </DockPanel>
              <TextBlock x:Name="HistoryCountText" DockPanel.Dock="Top" Margin="12,0,12,8" Foreground="#94A3B8" FontSize="12" Text="Showing 0 sessions"/>
              <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                        CanUserAddRows="False" CanUserResizeRows="False" GridLinesVisibility="Horizontal"
                        HorizontalGridLinesBrush="#EEF2F7" BorderThickness="0" Background="Transparent"
                        RowBackground="White" AlternatingRowBackground="#F8FAFC" RowHeight="36" FontSize="13">
                <DataGrid.ColumnHeaderStyle>
                  <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#F8FAFC"/>
                    <Setter Property="Foreground" Value="#64748B"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="12,10"/>
                    <Setter Property="BorderBrush" Value="#EEF2F7"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                  </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                  <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="12,0"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                          <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                          </Border>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Application" Binding="{Binding Application}" Width="1.2*"/>
                  <DataGridTextColumn Header="Process" Binding="{Binding Process}" Width="0.9*"/>
                  <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="0.7*"/>
                  <DataGridTextColumn Header="Started" Binding="{Binding Started}" Width="0.85*"/>
                  <DataGridTextColumn Header="Ended" Binding="{Binding Ended}" Width="0.6*"/>
                  <DataGridTextColumn Header="Active" Binding="{Binding Active}" Width="0.55*"/>
                  <DataGridTextColumn Header="Idle" Binding="{Binding Idle}" Width="0.55*"/>
                  <DataGridTextColumn Header="State" Binding="{Binding State}" Width="0.55*"/>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Border>
        </Grid>
      </TabItem>

      <!-- Device -->
      <TabItem Header="Device">
        <Border Margin="0,4,0,0" CornerRadius="18" Padding="22,18">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#0F172A" Offset="0"/>
              <GradientStop Color="#115E59" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
          <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.18"/>
          </Border.Effect>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="This device" Foreground="#99F6E4" FontSize="12"/>
                <TextBlock x:Name="DeviceNameText" Text="PC" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,2,0,0"/>
                <TextBlock x:Name="DeviceUserText" Text="User" Foreground="#CBD5E1" FontSize="13" Margin="0,2,0,0"/>
                <TextBlock x:Name="DeviceModelText" Text="" Foreground="#94A3B8" FontSize="12" Margin="0,4,0,0"/>
              </StackPanel>
              <Border DockPanel.Dock="Right" VerticalAlignment="Top" Background="#22C55E" CornerRadius="14" Padding="12,6">
                <TextBlock Text="Connected" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
              </Border>
            </DockPanel>

            <UniformGrid Grid.Row="1" Columns="2">
              <StackPanel Margin="0,0,14,0">
                <TextBlock Style="{StaticResource InfoKey}" Text="DEVICE ID"/>
                <TextBlock x:Name="DeviceIdText" Style="{StaticResource InfoVal}" Text="—" FontSize="12" TextWrapping="Wrap"/>
                <TextBlock Style="{StaticResource InfoKey}" Text="OPERATING SYSTEM"/>
                <TextBlock x:Name="DeviceOsText" Style="{StaticResource InfoVal}" Text="—" TextWrapping="Wrap"/>
                <TextBlock Style="{StaticResource InfoKey}" Text="OS BUILD"/>
                <TextBlock x:Name="DeviceOsBuildText" Style="{StaticResource InfoVal}" Text="—"/>
                <TextBlock Style="{StaticResource InfoKey}" Text="ARCHITECTURE"/>
                <TextBlock x:Name="DeviceArchText" Style="{StaticResource InfoVal}" Text="—"/>
                <TextBlock Style="{StaticResource InfoKey}" Text="CPU"/>
                <TextBlock x:Name="DeviceCpuText" Style="{StaticResource InfoVal}" Text="—" TextWrapping="Wrap"/>
              </StackPanel>
              <StackPanel>
                <TextBlock Style="{StaticResource InfoKey}" Text="RAM"/>
                <TextBlock x:Name="DeviceRamText" Style="{StaticResource InfoVal}" Text="—"/>
                <TextBlock Style="{StaticResource InfoKey}" Text="GPU"/>
                <TextBlock x:Name="DeviceGpuText" Style="{StaticResource InfoVal}" Text="—" TextWrapping="Wrap"/>
                <TextBlock Style="{StaticResource InfoKey}" Text="AGENT VERSION"/>
                <TextBlock x:Name="DeviceVersionText" Style="{StaticResource InfoVal}" Text="—"/>
                <TextBlock Style="{StaticResource InfoKey}" Text="FIRST INSTALLED"/>
                <TextBlock x:Name="DeviceInstalledText" Style="{StaticResource InfoVal}" Text="—"/>
                <TextBlock Style="{StaticResource InfoKey}" Text="FIRST SYNC"/>
                <TextBlock x:Name="DeviceFirstSyncText" Style="{StaticResource InfoVal}" Text="Not synced yet"/>
              </StackPanel>
            </UniformGrid>

            <Border Grid.Row="2" Background="#1AFFFFFF" CornerRadius="12" Padding="14" Margin="0,10,0,0">
              <StackPanel>
                <TextBlock Text="Last sync" Foreground="#99F6E4" FontSize="12"/>
                <TextBlock x:Name="DeviceLastSyncText" Text="—" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"/>
                <TextBlock x:Name="DeviceEndpointText" Text="—" Foreground="#CBD5E1" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </Grid>
        </Border>
      </TabItem>

      <!-- Settings -->
      <TabItem Header="Settings">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
          <StackPanel>
            <!-- Top device timeline card -->
            <Border CornerRadius="16" Padding="22" Margin="0,0,0,14">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Color="#134E4A" Offset="0"/>
                  <GradientStop Color="#0F172A" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="DEVICE" Foreground="#99F6E4" FontSize="11"/>
                  <TextBlock x:Name="SettingsDeviceNameText" Text="—" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="FIRST INSTALLED" Foreground="#99F6E4" FontSize="11"/>
                  <TextBlock x:Name="SettingsInstalledText" Text="—" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="FIRST SYNC" Foreground="#99F6E4" FontSize="11"/>
                  <TextBlock x:Name="SettingsFirstSyncText" Text="Not yet" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
              </Grid>
            </Border>

            <Border Background="White" CornerRadius="16" Padding="22">
              <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.08"/>
              </Border.Effect>
              <StackPanel>
                <TextBlock Text="General" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,16"/>
                <DockPanel Margin="0,0,0,18">
                  <StackPanel>
                    <TextBlock Style="{StaticResource SettingsLabel}" Text="RUN AT WINDOWS STARTUP"/>
                    <TextBlock x:Name="StartupStatusText" Style="{StaticResource SettingsValue}" Text="Off"/>
                  </StackPanel>
                  <CheckBox x:Name="StartupToggle" DockPanel.Dock="Right" VerticalAlignment="Center" Content="On" FontWeight="SemiBold"
                            Checked="StartupToggle_OnChanged" Unchecked="StartupToggle_OnChanged"/>
                </DockPanel>
                <Border Height="1" Background="#EEF2F7" Margin="0,0,0,18"/>
                <TextBlock Style="{StaticResource SettingsLabel}" Text="LAST SYNC"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                  <Ellipse x:Name="SettingsSyncDot" Width="10" Height="10" Fill="#94A3B8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                  <TextBlock x:Name="SettingsLastSyncTitle" Style="{StaticResource SettingsValue}" Text="Not synced yet"/>
                </StackPanel>
                <TextBlock x:Name="SettingsLastSyncDetails" Foreground="#64748B" FontSize="13" Text="—" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="16" Padding="22" Margin="0,14,0,0">
              <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.08"/>
              </Border.Effect>
              <StackPanel>
                <TextBlock Text="Automatic sync" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,8"/>
                <DockPanel Margin="0,0,0,16">
                  <StackPanel>
                    <TextBlock Style="{StaticResource SettingsLabel}" Text="AUTO SYNC"/>
                    <TextBlock Style="{StaticResource SettingsValue}" Text="Periodic upload"/>
                  </StackPanel>
                  <CheckBox x:Name="AutoSyncToggle" DockPanel.Dock="Right" VerticalAlignment="Center" Content="Enabled" FontWeight="SemiBold"/>
                </DockPanel>
                <TextBlock Style="{StaticResource SettingsLabel}" Text="INTERVAL"/>
                <ComboBox x:Name="SyncIntervalCombo" Width="220" HorizontalAlignment="Left" Margin="0,0,0,8">
                  <ComboBoxItem Tag="5" Content="Every 5 minutes"/>
                  <ComboBoxItem Tag="10" Content="Every 10 minutes"/>
                  <ComboBoxItem Tag="15" Content="Every 15 minutes" IsSelected="True"/>
                  <ComboBoxItem Tag="20" Content="Every 20 minutes"/>
                  <ComboBoxItem Tag="30" Content="Every 30 minutes"/>
                </ComboBox>
                <TextBlock x:Name="NextSyncText" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,16" Text="Next sync: —"/>
                <TextBlock Style="{StaticResource SettingsLabel}" Text="SYNC ENDPOINT"/>
                <TextBox x:Name="EndpointBox" Padding="10,8" FontSize="13" BorderBrush="#CBD5E1" BorderThickness="1"/>
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                  <Button Content="Save settings" Style="{StaticResource PrimaryButton}" Click="SaveSettings_OnClick"/>
                  <Button Content="Sync now" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="SyncButton_OnClick"/>
                </StackPanel>
                <TextBlock x:Name="SettingsHint" Foreground="#0D9488" FontSize="12" Margin="0,12,0,0" Text=""/>
              </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="16" Padding="22" Margin="0,14,0,0">
              <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.08"/>
              </Border.Effect>
              <StackPanel>
                <TextBlock Text="Ignore list" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,8"/>
                <TextBox x:Name="IgnoreListBox" AcceptsReturn="True" Height="110" FontFamily="Consolas" FontSize="12" Padding="10" BorderBrush="#CBD5E1"/>
              </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="16" Padding="22" Margin="0,14,0,0">
              <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.08"/>
              </Border.Effect>
              <StackPanel>
                <TextBlock Text="App categories" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,8"/>
                <TextBlock Text="Automatic by default (Steam/Epic/Xbox paths + known apps). Add a rule only to override."
                           Foreground="#94A3B8" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"/>
                <DockPanel Margin="0,0,0,10">
                  <TextBox x:Name="CategoryProcessBox" Width="180" Padding="8" Margin="0,0,8,0"/>
                  <ComboBox x:Name="CategoryPickBox" Width="150" Margin="0,0,8,0">
                    <ComboBoxItem Content="Work" IsSelected="True"/>
                    <ComboBoxItem Content="Browser"/>
                    <ComboBoxItem Content="Games"/>
                    <ComboBoxItem Content="Entertainment"/>
                    <ComboBoxItem Content="Communication"/>
                    <ComboBoxItem Content="System"/>
                    <ComboBoxItem Content="Other"/>
                  </ComboBox>
                  <Button Content="Add override" Style="{StaticResource GhostButton}" Click="AddCategoryRule_OnClick"/>
                </DockPanel>
                <ListBox x:Name="CategoryRulesList" Height="120" BorderBrush="#EEF2F7"/>
                <Button Content="Remove selected" Style="{StaticResource GhostButton}" Margin="0,10,0,0" HorizontalAlignment="Left" Click="RemoveCategoryRule_OnClick"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
